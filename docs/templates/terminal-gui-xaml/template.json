{
  "build": {
    "content": [
      {
        "files": ["**/*.md", "**/*.yml", "**/*.json"],
        "exclude": ["_site/**", "obj/**"]
      }
    ],
    "resource": [
      {
        "files": ["styles/**", "scripts/**"]
      }
    ],
    "global": {
      "_appLogoPath": "logo.svg",
      "_appFooter": "Terminal.Gui.Xaml Framework",
      "_copyrightFooter": "© 2025 Terminal.Gui.Xaml Contributors"
    }
  },
  "postProcessors": ["ExtractSearchIndex"],
  "namedUrlTemplate": {
    "" : "{name}.html"
  }
}