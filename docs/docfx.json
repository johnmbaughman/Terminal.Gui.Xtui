{
  "metadata": [
    {
      "src": [
        {
          "src": "../src/Terminal.Gui.Xaml",
          "files": [
            "Terminal.Gui.Xaml.csproj"
          ]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "properties": {
        "TargetFramework": "net8.0"
      },
      "shouldSkipMarkup": false,
      "namespaceLayout": "flattened"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "favicon.ico"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default"
    ],
    "globalMetadata": {
      "_appTitle": "Terminal.Gui.Xaml Documentation",
      "_appName": "Terminal.Gui.Xaml",
      "_appFooter": "Terminal.Gui.Xaml Framework",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/johnmbaughman/Terminal.Gui.Xaml",
        "branch": "main",
        "path": "docs"
      },
      "_gitUrlPattern": "github",
      "_copyrightFooter": "© 2025 Terminal.Gui.Xaml Contributors",
      "_lang": "en-us"
    },
    "fileMetadata": {
      "_displayLangs": {
        "*": ["csharp"]
      },
      "_appTitle": {
        "api/**/**.md": "Terminal.Gui.Xaml API Reference",
        "articles/concepts/**.md": "Terminal.Gui.Xaml Concepts",
        "articles/guides/**.md": "Terminal.Gui.Xaml Guides",
        "articles/examples/**.md": "Terminal.Gui.Xaml Examples"
      }
    },
    "postProcessors": [
      "ExtractSearchIndex"
    ],
    "markdownEngineName": "dfm",
    "keepFileLink": false,
    "cleanupCacheHistory": false,
    "maxParallelism": 0,
    "intermediateFolder": "obj",
    "noLangKeyword": false,
    "enableTabsByOrder": false,
    "validationRules": {
      "inputParameters": "warning",
      "fileNotFound": "error",
      "invalidFileLink": "error",
      "invalidBookmark": "error",
      "invalidCrossReference": "warning",
      "missingAttribute": "warning"
    }
  },
  "serve": {
    "port": 8080,
    "host": "localhost"
  }
}
