{
  "metadata": [
    {
      "src": [
        {
          "files": ["src/Terminal.Gui.Xaml/**/*.cs"],
          "exclude": [
            "src/Terminal.Gui.Xaml/**/Internal/**",
            "src/Terminal.Gui.Xaml/**/*.Designer.cs",
            "tests/**/*.cs"
          ]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "properties": {
        "TargetFramework": "net8.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default"
    ],
    "globalMetadata": {
      "_appTitle": "Terminal.Gui.Xaml Documentation",
      "_appName": "Terminal.Gui.Xaml",
      "_appFooter": "Terminal.Gui.Xaml Framework",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/terminal-gui-xaml/Terminal.Gui.Xaml",
        "branch": "main"
      },
      "_gitUrlPattern": "github"
    },
    "fileMetadata": {
      "_displayLangs": ["csharp"]
    },
    "postProcessors": ["ExtractSearchIndex"]
  }
}
