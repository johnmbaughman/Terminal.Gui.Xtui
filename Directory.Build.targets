<Project>
  <PropertyGroup>
    <!-- XML documentation generation for NuGet and IDE integration -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
    <!-- Strong naming for security -->
    <SignAssembly>false</SignAssembly>
    <!-- Semantic versioning -->
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <InformationalVersion>1.0.0</InformationalVersion>

    <!-- DocFX Documentation Configuration -->
    <DocumentationEnabled Condition="'$(Configuration)' == 'Release'">true</DocumentationEnabled>
    <DocumentationEnabled Condition="'$(Configuration)' != 'Release'">false</DocumentationEnabled>
    <DocumentationOutputPath>$(OutputPath)docs</DocumentationOutputPath>
    <DocumentationBuildMode>Incremental</DocumentationBuildMode>
    <RequiredDocumentationCoverage>80.0</RequiredDocumentationCoverage>
    <ValidateDocumentationLinks>true</ValidateDocumentationLinks>
    <ValidateDocumentationExamples>true</ValidateDocumentationExamples>
  </PropertyGroup>

  <!-- DocFX Documentation Targets -->
  <Target Name="GenerateDocumentation" AfterTargets="Build" Condition="'$(DocumentationEnabled)' == 'true'">
    <Message Text="Generating documentation with DocFX..." Importance="high" />
    <!-- DocFX execution will be implemented in the documentation service -->
  </Target>

  <Target Name="ValidateDocumentation" BeforeTargets="GenerateDocumentation" Condition="'$(DocumentationEnabled)' == 'true'">
    <Message Text="Validating documentation coverage and quality..." Importance="high" />
    <!-- Documentation validation will be implemented in the documentation service -->
  </Target>

  <Target Name="CleanDocumentation" AfterTargets="Clean">
    <Message Text="Cleaning generated documentation..." Importance="high" />
    <RemoveDir Directories="$(DocumentationOutputPath)" Condition="Exists('$(DocumentationOutputPath)')" />
  </Target>
  <!-- Import documentation targets -->
  <Import Project="src/Terminal.Gui.Xaml/Build/Terminal.Gui.Xaml.Documentation.targets" Condition="Exists('src/Terminal.Gui.Xaml/Build/Terminal.Gui.Xaml.Documentation.targets')" />
</Project>
