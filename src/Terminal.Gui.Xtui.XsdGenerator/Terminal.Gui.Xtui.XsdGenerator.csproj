<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Use the local Terminal.Gui project during development to ensure types like `View` are available -->
    <Reference Include="Terminal.Gui">
      <HintPath>..\Terminal.Gui\Terminal.Gui\bin\Debug\net10.0\Terminal.Gui.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Copy Terminal.Gui.xml from the local build to output directory -->
  <Target Name="CopyTerminalGuiXmlDocs" AfterTargets="Build">
    <Copy SourceFiles="..\Terminal.Gui\Terminal.Gui\bin\Debug\net10.0\Terminal.Gui.xml" 
          DestinationFolder="$(OutputPath)" 
          SkipUnchangedFiles="true"
          Condition="Exists('..\Terminal.Gui\Terminal.Gui\bin\Debug\net10.0\Terminal.Gui.xml')" />
  </Target>

</Project>
