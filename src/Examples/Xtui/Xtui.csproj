<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Terminal.Gui\Terminal.Gui\Terminal.Gui.csproj" />
    <ProjectReference Include="..\..\Terminal.Gui.Xtui.Generator\Terminal.Gui.Xtui.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />    
  </ItemGroup>

  <ItemGroup>
    <Folder Include="obj\" />
  </ItemGroup>

  <!-- Import generator targets manually since we're using ProjectReference -->
  <Import Project="..\..\Terminal.Gui.Xtui.Generator\buildTransitive\Terminal.Gui.Xtui.Generator.targets" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>  
  <PropertyGroup>
    <!-- Request the generator to emit the xtui manifest for this consuming project -->
    <XtuiEmitManifest>true</XtuiEmitManifest>
  </PropertyGroup>
  
</Project>
