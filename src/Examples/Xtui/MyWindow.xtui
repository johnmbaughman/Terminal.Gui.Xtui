<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.terminal.gui/xtui"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://schemas.terminal.gui/xtui ../../Terminal.Gui.Xtui/Terminal.Gui.Xtui.xsd">
    <!-- This is a simple label -->
    <Label Text="Hello" X="10" Y="5" Width="20" Height="1" />
    
    <!-- 
        Multi-line comment
        This button is centered
    -->
    <Button Id="_closeButton" Text="Close Application" X="{Center}" Y="50%" Width="80%" Height="3" />
    
    <!-- <Label Text="This is commented out" X="0" Y="0" Width="10" Height="1" /> -->
    
    <!-- Testing Pos operator expressions: Center - 10 -->
    <Label Text="Offset Left" X="{Center - 10}" Y="10" Width="20" Height="1" />
    
    <!-- Testing Pos operator expressions: Center + 5 -->
    <Label Text="Offset Right" X="{Center + 5}" Y="12" Width="20" Height="1" />
    
    <!-- Testing Pos AnchorEnd with offset -->
    <Label Text="From End" X="{AnchorEnd - 25}" Y="14" Width="20" Height="1" />
    
    <!-- Testing Dim operator expressions: Fill - 5 -->
    <Label Text="Fill Minus" X="5" Y="16" Width="{Fill - 5}" Height="1" />
    
    <!-- Testing Dim operator expressions: Auto + 2 -->
    <Label Text="Auto Plus" X="5" Y="18" Width="{Auto + 2}" Height="1" />
    
    <Label Text="Anchored" X="{AnchorEnd}" Y="{AnchorEnd + 5}" Width="{Auto}" Height="{Fill}" />
    
    <!-- CheckBox examples -->
    <CheckBox Text="Accept Terms" CheckedState="UnChecked" X="5" Y="20" />
    <CheckBox Text="Enable Notifications" CheckedState="Checked" X="5" Y="22" />
    <CheckBox Text="Tristate Option" CheckedState="None" AllowCheckStateNone="true" X="5" Y="24" />
    <CheckBox Text="Radio Style" CheckedState="Checked" RadioStyle="true" X="5" Y="26" />
    
    <!-- End of window content -->
</Window>
