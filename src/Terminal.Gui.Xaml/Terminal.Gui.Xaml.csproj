<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Default off; opt-in at solution level to avoid task load errors in isolated builds -->
    <EnableXamlDocumentation Condition=" '$(EnableXamlDocumentation)' == '' ">false</EnableXamlDocumentation>
    <SkipDocumentationTasks Condition=" '$(SkipDocumentationTasks)' == '' AND '$(EnableXamlDocumentation)' != 'true' ">true</SkipDocumentationTasks>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyTitle>Terminal.Gui XAML Framework</AssemblyTitle>
    <AssemblyDescription>A comprehensive XAML framework for Terminal.Gui v2+ that enables declarative UI development with Microsoft XAML standards compatibility.</AssemblyDescription>
    <Copyright>Copyright © 2025</Copyright>
  <AssemblyVersion>1.0.0.0</AssemblyVersion>
  <FileVersion>1.0.0.0</FileVersion>
  <PackageVersion>1.0.0-beta1</PackageVersion>
  <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Terminal.Gui.Xaml</PackageId>
    <PackageTags>terminal;gui;xaml;cli;tui;cross-platform</PackageTags>
    <PackageProjectUrl>https://github.com/terminal-gui-xaml/Terminal.Gui.Xaml</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Terminal.Gui.Xaml Contributors</Authors>
    <Company>Terminal.Gui.Xaml</Company>
    <RepositoryUrl>https://github.com/terminal-gui-xaml/Terminal.Gui.Xaml</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Terminal.Gui v2+ for UI components -->
    <PackageReference Include="Terminal.Gui" Version="2.0.0-develop.4559" />

    <!-- Microsoft.CodeAnalysis for Roslyn integration -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>


    <!-- Performance monitoring -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="9.0.9" />

  <!-- DocFX for documentation generation -->
  </ItemGroup>


  <!-- Pack documentation targets file so consumers get automatic task/targets import -->
  <ItemGroup>
    <None Include="Build\Terminal.Gui.Xaml.Documentation.targets" Pack="true" PackagePath="buildTransitive" />
    <None Include="Build\Terminal.Gui.Xaml.targets" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <!-- Adjust UsingTask in packed targets: rely on standard buildTransitive semantics; keep source version unchanged -->

</Project>
