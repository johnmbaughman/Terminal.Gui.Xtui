<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Documentation tooling targets for Terminal.Gui.Xaml
    Provides a wrapper target that can invoke the GenerateDocumentationTask (future real DocFX integration).
  -->

  <!-- When consumed from source, assembly is one level up. When packed (buildTransitive), assembly is resolved from project's obj/bin path automatically.
    We provide a conditional fallback path resolution. -->
  <UsingTask TaskName="Terminal.Gui.Xaml.Documentation.Build.GenerateDocumentationTask"
    AssemblyFile="$(MSBuildThisFileDirectory)..\Terminal.Gui.Xaml.dll"
    Condition="Exists('$(MSBuildThisFileDirectory)..\Terminal.Gui.Xaml.dll') AND '$(SkipDocumentationTasks)' != 'true'" />

  <PropertyGroup>
    <!-- Allow opt-in independent of configuration -->
    <EnableXamlDocumentation Condition=" '$(EnableXamlDocumentation)' == '' ">$(DocumentationEnabled)</EnableXamlDocumentation>
    <XamlDocumentationOutputPath Condition=" '$(XamlDocumentationOutputPath)' == '' ">$(DocumentationOutputPath)</XamlDocumentationOutputPath>
    <XamlDocumentationBuildMode Condition=" '$(XamlDocumentationBuildMode)' == '' ">$(DocumentationBuildMode)</XamlDocumentationBuildMode>
  </PropertyGroup>

  <!-- Main entry target: builds docs after successful compile when enabled -->
  <Target Name="XamlGenerateDocumentation"
    AfterTargets="Build"
    Condition="'$(EnableXamlDocumentation)' == 'true' AND '$(SkipDocumentationTasks)' != 'true'">
    <Message Text="[XAML-DOC] Starting documentation generation (Mode=$(XamlDocumentationBuildMode))" Importance="High" />
    <GenerateDocumentationTask />
    <Message Text="[XAML-DOC] Completed documentation generation." Importance="High" />
  </Target>

  <!-- Validation only target (can be invoked manually) -->
  <Target Name="XamlValidateDocumentation"
    DependsOnTargets="Build"
    Condition="'$(EnableXamlDocumentation)' == 'true' AND '$(SkipDocumentationTasks)' != 'true'">
    <Message Text="[XAML-DOC] Validating documentation (Mode=$(XamlDocumentationBuildMode))" Importance="High" />
    <!-- Future: Add separate validation task invocation if split -->
    <GenerateDocumentationTask />
  </Target>

  <!-- Clean hook -->
  <Target Name="XamlCleanDocumentation" AfterTargets="Clean">
    <RemoveDir Directories="$(XamlDocumentationOutputPath)" Condition="Exists('$(XamlDocumentationOutputPath)')" />
    <Message Text="[XAML-DOC] Cleaned documentation output folder $(XamlDocumentationOutputPath)" Importance="Low" />
  </Target>
</Project>
