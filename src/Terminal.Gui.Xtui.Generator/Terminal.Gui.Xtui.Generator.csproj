<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>
        <AssemblyName>Terminal.Gui.Xtui.Generator</AssemblyName>
        <!-- Path to XamlX source (following Avalonia pattern of embedding source) -->
        <XamlXSourcePath>$(MSBuildThisFileDirectory)..\XamlX\src\XamlX</XamlXSourcePath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Terminal.Gui.Xtui\Terminal.Gui.Xtui.csproj" />
    </ItemGroup>

    <!-- Include XamlX source directly into the analyzer (following Avalonia pattern).
         This avoids the assembly loading issue where Roslyn can't find dependent DLLs for analyzers. -->
    <ItemGroup>
        <Compile Include="$(XamlXSourcePath)/**/*.cs"
                 Exclude="$(XamlXSourcePath)/obj/**/*.cs;$(XamlXSourcePath)/IL/SreTypeSystem.cs"
                 LinkBase="XamlX" />
    </ItemGroup>

    <!-- Include the buildTransitive files and schema in the nupkg so consuming projects automatically import them -->
    <ItemGroup>
        <None Include="buildTransitive\Terminal.Gui.Xtui.Generator.targets" Pack="true" PackagePath="buildTransitive\"/>
        <None Include="buildTransitive\Terminal.Gui.Xtui.Generator.props" Pack="true" PackagePath="buildTransitive\"/>
        <None Include="Terminal.Gui.Xtui.Generator.xsd" Pack="true" PackagePath="schemas\"/>
    </ItemGroup>
    <ItemGroup>
        <Folder Include="analyzers\dotnet\cs\"/>
        <Folder Include="obj\" />
    </ItemGroup>



    <!-- Ensure the built generator DLL is packed into analyzers/dotnet/cs/ in the nupkg -->
    <Target Name="PrepareAnalyzerForPack" AfterTargets="Build">
        <ItemGroup>
            <_AnalyzerToPack Include="$(OutputPath)$(AssemblyName).dll"/>
        </ItemGroup>
        <Copy SourceFiles="@(_AnalyzerToPack)" DestinationFolder="$(ProjectDir)analyzers\dotnet\cs\" SkipUnchangedFiles="true"/>
        <ItemGroup>
            <None Include="analyzers\dotnet\cs\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs/"/>
        </ItemGroup>
    </Target>

</Project>
