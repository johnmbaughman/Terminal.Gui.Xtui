<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>
        <!-- When packing, place the built generator assembly into the analyzers folder in the nupkg -->
        <AnalyzerAssemblyName>Terminal.Gui.Xtui.Generator.dll</AnalyzerAssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\submodules\XamlX\src\XamlX\XamlX.csproj" />
    </ItemGroup>

    <!-- Include the buildTransitive files and schema in the nupkg so consuming projects automatically import them -->
    <ItemGroup>
        <None Include="buildTransitive\Terminal.Gui.Xtui.targets" Pack="true" PackagePath="buildTransitive\"/>
        <None Include="buildTransitive\Terminal.Gui.Xtui.props" Pack="true" PackagePath="buildTransitive\"/>
        <None Include="Terminal.Gui.Xtui.xsd" Pack="true" PackagePath="schemas\"/>
    </ItemGroup>
    <ItemGroup>
        <Folder Include="analyzers\dotnet\cs\"/>
        <Folder Include="obj\" />
    </ItemGroup>

    <!-- Regenerate XSD schema from Terminal.Gui metadata before build -->
    <Target Name="RegenerateXsdSchema" BeforeTargets="BeforeBuild">
        <Message Text="Regenerating Terminal.Gui.Xtui.xsd from Terminal.Gui metadata..." Importance="high" />
        <Exec Command="dotnet run --project &quot;$(ProjectDir)..\Terminal.Gui.Xtui.XsdGenerator\Terminal.Gui.Xtui.XsdGenerator.csproj&quot; &quot;$(ProjectDir)Terminal.Gui.Xtui.xsd&quot;" />
    </Target>

    <!-- Ensure the built generator DLL is packed into analyzers/dotnet/cs/ in the nupkg. The built output will be copied during pack. -->
    <Target Name="PrepareAnalyzerForPack" AfterTargets="Build">
        <ItemGroup>
            <_AnalyzerToPack Include="$(OutputPath)$(AssemblyName).dll"/>
        </ItemGroup>
        <Copy SourceFiles="@(_AnalyzerToPack)" DestinationFolder="$(ProjectDir)analyzers\dotnet\cs\" SkipUnchangedFiles="true"/>
        <ItemGroup>
            <None Include="analyzers\dotnet\cs\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs/"/>
        </ItemGroup>
    </Target>

</Project>
