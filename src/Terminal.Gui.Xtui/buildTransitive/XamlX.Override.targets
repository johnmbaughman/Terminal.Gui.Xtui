<Project>
  <!-- Enforce XamlX TFMs/langversion after project evaluation for any project under the XamlX tree -->
  <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectDirectory)').ToLowerInvariant().Contains('xamlx'))">
    <LangVersion>12.0</LangVersion>
    <TargetFramework>netstandard2.0</TargetFramework>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <ExcludeTargetFrameworks>net10.0;net8.0</ExcludeTargetFrameworks>
  </PropertyGroup>
</Project>
