<Project>
  <!-- Override XamlX TFMs/langversion without modifying the submodule files -->
  <PropertyGroup Condition="'$(MSBuildProjectName)'=='XamlX' OR '$(MSBuildProjectName)'=='XamlX.Parser.GuiLabs' OR '$(MSBuildProjectName)'=='XamlX.Runtime' OR '$(MSBuildProjectName)'=='XamlX.IL.Cecil'">
    <LangVersion>12.0</LangVersion>
    <TargetFramework>netstandard2.0</TargetFramework>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <ExcludeTargetFrameworks>net10.0;net8.0</ExcludeTargetFrameworks>
  </PropertyGroup>
</Project>
